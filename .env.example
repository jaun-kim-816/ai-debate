# Copy to .env and fill in your keys.
# cp .env.example .env

# OpenAI (지피티)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic (클로드)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Server
PORT=5178

# Set MOCK=1 to run with canned responses (no API keys needed) — for trying the UI / testing.
MOCK=0
